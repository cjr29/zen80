			"command": "go build -o zen80",
			"options": {
				"env": {
					"GOOS": "linux",
					"GOARCH": "arm64",
					"CGO_ENABLED": "0"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": []
		},
		{
			"label": "Build for Raspberry Pi Zero W (32-bit ARMv6)",

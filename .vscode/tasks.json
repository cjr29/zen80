					"GOARM": "6",
					"CGO_ENABLED": "0"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": []
		},
		{
			"label": "Build Raspberry Pi targets",
			"dependsOn": [
				"Build for Raspberry Pi (arm64)",
				"Build for Raspberry Pi Zero W (32-bit ARMv6)"
			],
			"dependsOrder": "sequence",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
